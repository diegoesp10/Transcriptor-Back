{
  "Logging": { "LogLevel": { "Default": "Warning", "MeetingTranscriber": "Information", "System.Net.Http.HttpClient": "Warning" } },
  "AllowedHosts": "localhost;127.0.0.1",
  "Security": { "ApiKey": "" },
  "RequestLimits": {
    "GlobalPerMinute": 600,
    "PerIpPerMinute": 120,
    "ReadPerMinute": 60,
    "WritePerMinute": 10,
    "UploadPerMinute": 3,
    "RetryPerMinute": 3,
    "SummaryPerMinute": 2,
    "MaxConcurrentRequests": 20,
    "PerIpConcurrentRequests": 6,
    "MaxConcurrentUploads": 2,
    "PerIpBurstRequests": 30,
    "BurstWindowSeconds": 10,
    "AuthenticationFailuresPerMinute": 5,
    "UnknownRoutesPerMinute": 10,
    "RateViolationsPerMinute": 3,
    "BlockSeconds": 120,
    "MaxBlockSeconds": 900,
    "MaxTrackedIps": 4096,
    "IdleRetentionMinutes": 30,
    "MaxNonUploadBodyBytes": 16384,
    "EndpointPerMinute": {}
  },
  "Transcription": {
