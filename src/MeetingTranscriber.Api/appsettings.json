      "PythonPath": "../../tools/diarization/.venv/Scripts/python.exe",
      "ScriptPath": "../../scripts/diarize.py",
      "ModelPath": "../../tools/diarization/models/community-1",
      "Device": "cpu",
      "MinSpeakers": 1,
      "MaxSpeakers": 20,
      "TimeoutMinutes": 60
    },
    "LocalSummary": {
      "BaseUrl": "http://127.0.0.1:11434/",
      "Model": "qwen3:8b",
      "BatchCharacters": 12000,
      "ContextTokens": 16384,
      "TimeoutMinutes": 20
    },
    "TemporaryRetentionHours": 24
  }
